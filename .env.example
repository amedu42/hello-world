# Enables AI features (programme reading for PDFs, quick fill from notes, report summaries, project insights)
ANTHROPIC_API_KEY=
# Optional
# CLAUDE_MODEL=claude-opus-5-5
# PORT=3001
# DATA_DIR=./data
# Your email as the platform owner: sees the Customer companies admin page,
# and receives any projects created before company accounts existed when you sign up with it.
PLATFORM_ADMIN_EMAIL=

# Public address of the site, used in password reset emails.
# On Render this is detected automatically (RENDER_EXTERNAL_URL); set it if you use your own domain.
# APP_URL=https://app.yourdomain.com

# Email for password resets (any SMTP provider). Without these, reset links are printed to the server log.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Proj4D <no-reply@yourdomain.com>

# Shown on the Terms of Service and Privacy Policy pages
# LEGAL_BUSINESS_NAME=
# LEGAL_CONTACT_EMAIL=
# LEGAL_GOVERNING_LAW=
# LEGAL_EFFECTIVE_DATE=
